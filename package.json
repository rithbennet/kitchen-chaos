{
  "name": "kitchen-chaos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "test": "node --test tests/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kitchen-chaos-leaderboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply kitchen-chaos-leaderboard --remote"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.44.5",
    "vite": "6.1.0",
    "wrangler": "^4.147.0"
  }
}
